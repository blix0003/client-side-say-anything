local function updateCanvas()
    ListFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 16)
end

local function updateCount()
    local n = 0
    for _ in pairs(selected) do
        n = n + 1
    end
    CountLabel.Text = "Selected: " .. tostring(n)

    local total = 0
    for _ in pairs(rowRefs) do
        total = total + 1
    end
    allSelected = (total > 0 and n == total)
    SelectAllBtn.Text = allSelected and "Deselect All" or "Select All"
end

local function setRowVisual(userId, on)
    local row = rowRefs[userId]
    local check = checkRefs[userId]
    if not row or not check then return end
    if on then
        row.BackgroundColor3 = Color3.fromRGB(55, 90, 140)
        check.Text = "✓"
        check.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        row.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        check.Text = ""
        check.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end

local function togglePlayer(userId)
    if selected[userId] then
        selected[userId] = nil
        setRowVisual(userId, false)
    else
        selected[userId] = true
        setRowVisual(userId, true)
    end
    updateCount()
end

local function playerLabel(plr)
    local display = plr.DisplayName
    local name = plr.Name
    if display == name then
        return "@" .. name
    end
    return display .. "  @" .. name
end

local function getSelectedPlayers()
    local list = {}
    for userId in pairs(selected) do
        local plr = Players:GetPlayerByUserId(userId)
        if plr then
            table.insert(list, plr)
        end
    end
    return list
end

local function makeRow(plr)
    if unloaded then return end
    if rowRefs[plr.UserId] then return end

    local row = Instance.new("TextButton")
    row.Name = "Player_" .. tostring(plr.UserId)
    row.Size = UDim2.new(1, -4, 0, 32)
    row.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    row.BorderSizePixel = 0
    row.Text = ""
    row.AutoButtonColor = false
    row.LayoutOrder = string.lower(plr.Name):byte(1) or 0
    row.Parent = ListFrame
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local check = Instance.new("TextLabel")
    check.Name = "Check"
    check.Size = UDim2.new(0, 24, 1, 0)
    check.Position = UDim2.new(0, 6, 0, 0)
    check.BackgroundTransparency = 1
    check.Text = ""
    check.TextColor3 = Color3.fromRGB(180, 180, 180)
    check.Font = Enum.Font.GothamBold
    check.TextSize = 14
    check.Parent = row

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, -40, 1, 0)
    nameLabel.Position = UDim2.new(0, 32, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = playerLabel(plr)
    nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.TextSize = 13
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Parent = row

    rowRefs[plr.UserId] = row
    checkRefs[plr.UserId] = check

    if selected[plr.UserId] then
        setRowVisual(plr.UserId, true)
    end

    row.MouseButton1Click:Connect(function()
        if unloaded then return end
        togglePlayer(plr.UserId)
    end)

    updateCanvas()
end

local function removeRow(userId)
    local row = rowRefs[userId]
    if row then
        row:Destroy()
    end
    rowRefs[userId] = nil
    checkRefs[userId] = nil
    selected[userId] = nil
    updateCanvas()
    updateCount()
end

local function rebuildList()
    for _, plr in ipairs(Players:GetPlayers()) do
        makeRow(plr)
    end
    updateCanvas()
    updateCount()
end

-- Normal distance bubble
local function fakeBubble(plr, text)
    if not plr or not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if not head then return end

    pcall(function()
        Chat:Chat(head, text, Enum.ChatColor.White)
    end)
end

-- Show in chat with the player's real name color
local function fakeChatMessage(plr, text)
    local nameColor = getNameColor(plr.UserId)

    pcall(function()
        StarterGui:SetCore("ChatMakeSystemMessage", {
            Text = plr.DisplayName .. ": " .. text,
            Color = nameColor,
            Font = Enum.Font.SourceSansBold,
            TextSize = 18
        })
    end)

    pcall(function()
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then
            channel:DisplaySystemMessage(plr.DisplayName .. ": " .. text)
        end
    end)
end

SendBtn.MouseButton1Click:Connect(function()
    if unloaded then return end

    local text = TextBox.Text
    if text == "" then return end

    local list = getSelectedPlayers()

    for _, plr in ipairs(list) do
        fakeBubble(plr, text)
        fakeChatMessage(plr, text)
    end

    if getgenv().BlixOnSend then
        getgenv().BlixOnSend(text, list)
    end
end)

SelectAllBtn.MouseButton1Click:Connect(function()
    if unloaded then return end
    if allSelected then
        for userId, _ in pairs(rowRefs) do
            selected[userId] = nil
            setRowVisual(userId, false)
        end
    else
        for userId, _ in pairs(rowRefs) do
            selected[userId] = true
            setRowVisual(userId, true)
        end
    end
    updateCount()
end)

ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

rebuildList()

Players.PlayerAdded:Connect(function(plr)
    task.wait(0.15)
    if not unloaded then
        makeRow(plr)
        updateCount()
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    removeRow(plr.UserId)
end)

local function doUnload()
    if unloaded then return end
    unloaded = true
    guiVisible = false
    pcall(function()
        ScreenGui:Destroy()
    end)
end

CloseBtn.MouseButton1Click:Connect(doUnload)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if unloaded then return end
    if input.KeyCode == toggleKey then
        guiVisible = not guiVisible
        MainFrame.Visible = guiVisible
    end
end)

getgenv().BlixSelectedPlayers = getSelectedPlayers
getgenv().BlixTextBoxText = function()
    return TextBox.Text
end

